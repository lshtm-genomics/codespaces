#!/bin/bash
# Fake multiqc — mimics `multiqc -o fastqc_combined fastqc_reports`
# Copies the pre-made combined report (html + data dir) into the requested
# output directory, regardless of what input directory was actually given.

CANNED="${MICROBIOME_CANNED:-/opt/microbiome-canned}"
DELAY_MIN="${MULTIQC_FAKE_DELAY_MIN:-5}"
DELAY_MAX="${MULTIQC_FAKE_DELAY_MAX:-15}"
DELAY=$(( RANDOM % (DELAY_MAX - DELAY_MIN + 1) + DELAY_MIN ))

outdir="."

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--outdir) outdir="$2"; shift 2 ;;
        *) shift ;;
    esac
done

sleep "$DELAY"
mkdir -p "$outdir"

if [[ -d "$CANNED/fastqc_combined" ]]; then
    cp -r "$CANNED"/fastqc_combined/. "$outdir"/
    echo "MultiQC report generated in $outdir"
else
    echo "[fake-multiqc WARNING] no canned fastqc_combined/ directory found at $CANNED" >&2
fi
